# Токен бота-продавца (его даёт узел из @BotFather)
SELLER_BOT_TOKEN=

# Telegram user id владельца бота (узла) — ему VPN бесплатно (кнопка «Мой VPN»)
OWNER_ID=

# Цена и срок доступа
PRICE_STARS=50
VPN_DAYS=30

# Ссылка на бота-станок для кнопки «Заработай так же»
STANOK_URL=https://t.me/VPNForge_bot

# Доменное имя узла (nodeN.<зона>) — пишет станок при разворачивании.
# Нужно оплате картой через Tribute: вебхук приходит по HTTPS на имя с сертификатом.
NODE_DOMAIN=

# Порт приёма вебхуков Tribute. 443 занят самим VPN, 80 нужен certbot для продления.
TRIBUTE_WEBHOOK_PORT=8443
