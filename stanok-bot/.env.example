# Токен бота-станка от @BotFather
BOT_TOKEN=

# Ключ шифрования кредов (необязательно): 64 hex-символа.
# Если оставить пустым — сгенерится сам в файл .enckey при первом запуске.
ENCRYPTION_KEY=

# Твоя реф-ссылка OneDash (по умолчанию уже подставлена)
REFERRAL_LINK=https://rdp-onedash.ru/r/2b3c405

# Ссылка на самого станка (для кнопки «Заработай так же» в ботах-продавцах)
STANOK_URL=https://t.me/VPNForge_bot

# Файл базы
DB_PATH=stanok.db

# Твой Telegram user id (через запятую). Нужен, чтобы бот отдавал file_id присланных тобой видео.
ADMIN_IDS=

# file_id видео-инструкций. Как получить: пропиши свой id в ADMIN_IDS, запусти бота,
# отправь ему видео — он ответит его file_id. Вставь сюда. Пусто → бот покажет текст.
INSTR_BUY_VIDEO=
INSTR_IP_VIDEO=
INSTR_PASSWORD_VIDEO=
INSTR_TOKEN_VIDEO=
